<Solution>
  <Project Path="PMXExtensions/PMXExtensions.csproj" />
  <Project Path="Sari PMXPlugins/Sari PMXPlugins.csproj" />
  <Project Path="PmxEditor/PmxEditor_x64.exe">
    <BuildType Project="Release" />
    <Platform Project="x64" />
    <Properties Name="DebuggerProjectSystem">
      <Property Name="AttachLaunchAction" Value="Yes" />
      <Property Name="Environment" Value="Default" />
      <Property Name="Executable" Value="PmxEditor/PmxEditor_x64.exe" />
      <Property Name="IORedirection" Value="Auto" />
      <Property Name="StartingDirectory" Value="PmxEditor" />
      <Property Name="UseLegacyDebugEngines" Value="No" />
    </Properties>
  </Project>
</Solution>
